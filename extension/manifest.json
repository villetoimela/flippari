{
  "manifest_version": 3,
  "name": "Flippari – ristiinlistaus",
  "short_name": "Flippari",
  "version": "0.2.0",
  "description": "Täyttää Torin ja Vintedin ilmoituslomakkeet Flippari-dashboardista yhdellä klikkauksella.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flippari"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.tori.fi/*",
    "https://www.vinted.fi/*",
    "https://*.supabase.co/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://*.vercel.app/*",
      "https://*.netlify.app/*",
      "https://*.pages.dev/*",
      "https://*.github.io/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tori.fi/*"
      ],
      "js": [
        "content/common.js",
        "content/tori.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.vinted.fi/*"
      ],
      "js": [
        "content/common.js",
        "content/vinted.js"
      ],
      "run_at": "document_idle"
    }
  ]
}